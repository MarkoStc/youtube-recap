# Environment variables youtube-recap reads. Nothing loads this file automatically:
# export the variables in your shell, or set them in your MCP client's server config.

# Optional: YAML file merged over the packaged defaults (see docs/clients.md).
YOUTUBE_RECAP_CONFIG=

# Only for `youtube-recap eval` (the evaluation harness). Not needed to run the server.
# Alternatively, log in once with `ant auth login`.
ANTHROPIC_API_KEY=
